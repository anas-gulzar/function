#include <stdio.h>
void swap(int *a, int *b){
    int temp;
    temp=*a;
    *a=*b;
    *b=temp;

    printf("a = %d ,b = %d \n", *a ,*b);
}
int main(){
    int a;
    printf("enter value of a :");
    scanf("%d",&a);
    
    int b;
    printf("enter value of b :");
    scanf("%d",&b);


    swap(&a,&b);
    printf("a = %d ,b = %d \n", a ,b);
}
